DEEPSEEK_API_KEY=
# 服务器命令行使用 PLAYMORI_ENV_FILE=/etc/playmori/playmori.env 指定受限环境文件；不要把该变量写入本文件。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=4173
HOST=0.0.0.0
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=playmori
DB_USER=playmori
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT=10000
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=
ANALYTICS_ENABLED=true
ANALYTICS_SALT=
ANALYTICS_DIR=/var/lib/playmori/analytics
ANALYTICS_RETENTION_DAYS=30
SESSION_COOKIE_NAME=playmori_session
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=30
ACCOUNT_IDENTITY_HASH_SECRET=
ACCOUNT_IDENTITY_ENCRYPTION_KEY=
PHONE_OTP_SECRET=
PHONE_OTP_TTL_MINUTES=5
PHONE_CHALLENGE_RETENTION_DAYS=30
# 本地开发可使用 console，生产环境必须使用 aliyun-auth。
SMS_PROVIDER=disabled
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 从“号码认证服务 > 短信认证参数配置”选择当前可用的赠送签名和登录/注册模板。
ALIYUN_SMS_AUTH_SIGN_NAME=
ALIYUN_SMS_AUTH_TEMPLATE_CODE=
# 可留空使用默认方案；填写后必须与发送、核验使用的方案一致，且不超过 20 个字符。
ALIYUN_SMS_AUTH_SCHEME_NAME=
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_CHANNEL=
PUBLIC_PRIVACY_EMAIL=
BACKUP_DIR=/var/backups/playmori
BACKUP_RETENTION_DAYS=30
